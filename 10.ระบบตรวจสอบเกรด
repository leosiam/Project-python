def check_grade():
    score = float(input("กรอกคะแนน (0-100): "))
    if 80 <= score <= 100:
        print("เกรด: A")
    elif 70 <= score < 80:
        print("เกรด: B")
    elif 60 <= score < 70:
        print("เกรด: C")
    elif 50 <= score < 60:
        print("เกรด: D")
    elif 0 <= score < 50:
        print("เกรด: F")
    else:
        print("คะแนนไม่ถูกต้อง")

check_grade()
