def hangman():
    word = "python"
    guessed = ["_"] * len(word)
    attempts = 6
    print("เกม Hangman เริ่มต้น!")

    while attempts > 0 and "_" in guessed:
        print("\nคำปัจจุบัน:", " ".join(guessed))
        print(f"โอกาสที่เหลือ: {attempts}")
        guess = input("ทายตัวอักษร: ").lower()

        if guess in word:
            for i, char in enumerate(word):
                if char == guess:
                    guessed[i] = guess
            print("ถูกต้อง!")
        else:
            attempts -= 1
            print("ผิด!")
    
    if "_" not in guessed:
        print(f"คุณชนะ! คำคือ '{word}'")
    else:
        print(f"คุณแพ้! คำที่ถูกต้องคือ '{word}'")

hangman()
