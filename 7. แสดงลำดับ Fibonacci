def fibonacci_sequence():
    print("โปรแกรมแสดงลำดับ Fibonacci")
    n = int(input("กรอกจำนวนตัวเลข Fibonacci ที่ต้องการแสดง: "))
    
    if n <= 0:
        print("กรุณากรอกค่ามากกว่า 0")
        return

    sequence = [0, 1]
    for _ in range(2, n):
        sequence.append(sequence[-1] + sequence[-2])
    
    print("ลำดับ Fibonacci:")
    print(", ".join(map(str, sequence[:n])))

fibonacci_sequence()
